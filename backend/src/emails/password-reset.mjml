<mjml>
  <mj-body background-color="#f8fafc">
    <mj-section background-color="#1a56db">
      <mj-column>
        <mj-text align="center" color="#ffffff" font-size="24px" font-weight="bold" padding="40px 0">
          Reset Your Password
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#ffffff">
      <mj-column width="100%">
        <mj-text font-size="16px" line-height="1.6" color="#334155" padding="30px">
          Hi {{name}},
        </mj-text>
        <mj-text font-size="14px" line-height="1.6" color="#334155" padding="0 30px">
          We received a request to reset your NestMart password. If you didn't make this request, you can safely ignore this email.
        </mj-text>
        <mj-text font-size="14px" line-height="1.6" color="#334155" padding="15px 30px">
          To reset your password, click the button below. This link will expire in 30 minutes.
        </mj-text>
        <mj-button href="{{resetLink}}" background-color="#f59e0b" font-size="16px" padding="20px 30px">
          Reset Password
        </mj-button>
        <mj-text font-size="12px" line-height="1.6" color="#64748b" padding="20px 30px">
          Or copy and paste this link in your browser:
        </mj-text>
        <mj-text font-size="11px" color="#0369a1" padding="0 30px 30px 30px" line-height="1.4">
          {{resetLink}}
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#fee2e2">
      <mj-column width="100%">
        <mj-text font-size="12px" color="#7f1d1d" padding="15px 30px" font-weight="bold">
          ⚠️ Security Notice
        </mj-text>
        <mj-text font-size="12px" color="#7f1d1d" padding="0 30px 15px 30px" line-height="1.6">
          If you didn't request this password reset, please secure your account immediately by logging in and changing your password, or contact our support team.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#f8fafc">
      <mj-column width="100%">
        <mj-text align="center" font-size="10px" color="#94a3b8" padding="20px">
          © 2025 NestMart. All rights reserved.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
