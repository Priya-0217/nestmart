<mjml>
  <mj-body background-color="#f8fafc">
    <mj-section background-color="#1a56db">
      <mj-column>
        <mj-text align="center" color="#ffffff" font-size="24px" font-weight="bold" padding="40px 0">
          Verify Your Email
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#ffffff">
      <mj-column width="100%">
        <mj-text font-size="14px" line-height="1.6" color="#334155" padding="30px">
          Your NestMart verification code is:
        </mj-text>
        <mj-text align="center" font-size="36px" font-weight="bold" letter-spacing="4px" color="#1a56db" padding="30px" background-color="#f0f9ff" border-radius="8px">
          {{otp}}
        </mj-text>
        <mj-text font-size="12px" line-height="1.6" color="#64748b" padding="20px 30px">
          This code will expire in 10 minutes. If you didn't request this code, you can ignore this email.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#f8fafc">
      <mj-column width="100%">
        <mj-text align="center" font-size="10px" color="#94a3b8" padding="20px">
          © 2025 NestMart. All rights reserved.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
