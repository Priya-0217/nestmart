<mjml>
  <mj-body background-color="#f8fafc">
    <mj-section background-color="#1a56db">
      <mj-column>
        <mj-text align="center" color="#ffffff" font-size="28px" font-weight="bold" padding="40px 0">
          Welcome to NestMart
        </mj-text>
        <mj-text align="center" color="#e0e7ff" font-size="16px" padding="0 0 40px 0">
          Your Home. Your Style. Your Mart.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#ffffff">
      <mj-column width="100%">
        <mj-text font-size="16px" line-height="1.6" color="#334155" padding="30px">
          Hi <strong>{{name}}</strong>,
        </mj-text>
        <mj-text font-size="16px" line-height="1.6" color="#334155" padding="0 30px">
          Welcome to NestMart! We're thrilled to have you on board. 
        </mj-text>
        <mj-text font-size="16px" line-height="1.6" color="#334155" padding="15px 30px">
          Your account is now active and ready to explore our curated collection of home goods, kitchenware, decor, and everyday essentials. 
        </mj-text>
        <mj-button href="https://nestmart.com" background-color="#f59e0b" font-size="16px" padding="20px 30px">
          Start Shopping
        </mj-button>
        <mj-text font-size="14px" line-height="1.6" color="#64748b" padding="30px">
          If you have any questions, feel free to reach out to our support team. We're here to help!
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#f8fafc">
      <mj-column width="100%">
        <mj-text align="center" font-size="12px" color="#94a3b8" padding="30px">
          © 2025 NestMart. All rights reserved.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
