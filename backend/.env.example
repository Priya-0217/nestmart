# =============================================================================
# NestMart Backend — Environment Variables
# =============================================================================
# Copy this file to backend/.env and fill in real values as you acquire them.
# Every variable is documented inline. Placeholder values are safe for local
# dev; production values are listed next to each where relevant.

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
# "development" | "test" | "production" — controls logger prettification, Mongo
# auto-index, and a few other dev-only behaviours.
NODE_ENV=development

# HTTP port the API listens on.
PORT=5000

# Origin of the Next.js frontend. CORS is restricted to this exact origin.
# Staging: https://nestmart-web.vercel.app   Prod: https://nestmart.com
CLIENT_ORIGIN=http://localhost:3000

# -----------------------------------------------------------------------------
# Databases
# -----------------------------------------------------------------------------
# MongoDB — products, orders, categories, coupons, reviews, wishlists.
# Local (docker-compose): mongodb://localhost:27017/nestmart
# Atlas (prod): swap to the SRV connection string from Atlas -> Connect.
MONGODB_URI=mongodb://localhost:27017/nestmart

# PostgreSQL — users, sessions, addresses, auth tokens.
# Local (docker-compose): postgresql://nestmart:nestmart@localhost:5432/nestmart?schema=public
# Neon (prod): paste the pooled connection string from the Neon dashboard.
DATABASE_URL=postgresql://nestmart:nestmart@localhost:5432/nestmart?schema=public

# -----------------------------------------------------------------------------
# JWT
# -----------------------------------------------------------------------------
# Access-token signing secret. MUST be a long random string (>= 32 chars).
# Generate: openssl rand -hex 32
JWT_ACCESS_SECRET=dev-access-secret-change-me-please-change

# Refresh-token signing secret. Same rules; MUST differ from access secret.
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-please-change

# Access-token lifetime (zeit/ms format). Spec requires 15m.
JWT_ACCESS_TTL=15m

# Refresh-token lifetime. Spec requires 7d (rotated on use).
JWT_REFRESH_TTL=7d

# -----------------------------------------------------------------------------
# Passwords
# -----------------------------------------------------------------------------
# bcrypt cost. Spec requires >= 12. Higher = slower + more secure.
BCRYPT_COST=12

# -----------------------------------------------------------------------------
# SMTP (Mailtrap for staging)
#   mailtrap.io -> Email Testing -> Inboxes -> SMTP Settings
# -----------------------------------------------------------------------------
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=__PLACEHOLDER__mailtrap_username
SMTP_PASS=__PLACEHOLDER__mailtrap_password
MAIL_FROM=NestMart <no-reply@nestmart.dev>

# -----------------------------------------------------------------------------
# Stripe — dashboard.stripe.com -> Developers -> API keys (test mode)
# -----------------------------------------------------------------------------
# Starts with sk_test_
STRIPE_SECRET_KEY=__PLACEHOLDER__sk_test_xxx
# Starts with pk_test_ — also exposed to the frontend.
STRIPE_PUBLISHABLE_KEY=__PLACEHOLDER__pk_test_xxx
# From the Stripe CLI: `stripe listen --forward-to localhost:5000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=__PLACEHOLDER__whsec_xxx

# -----------------------------------------------------------------------------
# Razorpay — dashboard.razorpay.com -> Account & Settings -> API Keys (Test)
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=__PLACEHOLDER__rzp_test_xxx
RAZORPAY_KEY_SECRET=__PLACEHOLDER__rzp_secret_xxx
# Configured when creating a webhook in Razorpay dashboard -> Webhooks.
RAZORPAY_WEBHOOK_SECRET=__PLACEHOLDER__rzp_webhook_secret

# -----------------------------------------------------------------------------
# Google OAuth — console.cloud.google.com -> APIs & Services -> Credentials
# -----------------------------------------------------------------------------
# Create an OAuth 2.0 Client ID (Web application). Authorised redirect URI:
#   http://localhost:3000/api/auth/callback/google   (NextAuth local)
#   https://<frontend-domain>/api/auth/callback/google   (production)
GOOGLE_CLIENT_ID=__PLACEHOLDER__google_client_id
GOOGLE_CLIENT_SECRET=__PLACEHOLDER__google_client_secret

# -----------------------------------------------------------------------------
# Feature flags
# -----------------------------------------------------------------------------
# When true, Cash-on-Delivery is selectable at checkout.
COD_ENABLED=true

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# One of: fatal, error, warn, info, debug, trace
LOG_LEVEL=info
