# =============================================================================
# NestMart Backend — Environment Variables
# =============================================================================
# Copy this file to backend/.env and fill in real values as you acquire them.
# Every variable is documented inline. Placeholder values are safe for local
# dev; production values are listed next to each where relevant.

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
# "development" | "test" | "production" — controls logger prettification, Mongo
# auto-index, and a few other dev-only behaviours.
NODE_ENV=development

# HTTP port the API listens on.
PORT=5000

# Origin of the Next.js frontend. CORS is restricted to this exact origin.
# Staging: https://nestmart-web.vercel.app   Prod: https://nestmart.com
CLIENT_ORIGIN=http://localhost:3000

# -----------------------------------------------------------------------------
# Databases
# -----------------------------------------------------------------------------
# MongoDB — products, orders, categories, coupons, reviews, wishlists.
MONGODB_URI=mongodb://localhost:27017/nestmart

# PostgreSQL — users, sessions, addresses, auth tokens.
DATABASE_URL=postgresql://nestmart:nestmart@localhost:5432/nestmart?schema=public

# -----------------------------------------------------------------------------
# JWT
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=dev-access-secret-change-me-please-change
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-please-change
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# -----------------------------------------------------------------------------
# Passwords
# -----------------------------------------------------------------------------
BCRYPT_COST=12

# -----------------------------------------------------------------------------
# SMTP (Mailtrap for staging)
# -----------------------------------------------------------------------------
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=__PLACEHOLDER__
SMTP_PASS=__PLACEHOLDER__
MAIL_FROM=NestMart <no-reply@nestmart.dev>

# -----------------------------------------------------------------------------
# Google OAuth
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=__PLACEHOLDER__
GOOGLE_CLIENT_SECRET=__PLACEHOLDER__

# -----------------------------------------------------------------------------
# Stripe Integration
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# -----------------------------------------------------------------------------
# Razorpay Integration
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=__PLACEHOLDER__
RAZORPAY_WEBHOOK_SECRET=__PLACEHOLDER__

# Sanity CMS Integration (Phase 3D)
# -----------------------------------------------------------------------------
# Sanity project ID and dataset for CMS content (banners, blog, featured products)
SANITY_PROJECT_ID=__PLACEHOLDER__
SANITY_DATASET=production
# Read-only API token for fetching published content
SANITY_API_TOKEN=__PLACEHOLDER__

# Cloudinary image storage
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=__PLACEHOLDER__
CLOUDINARY_API_KEY=__PLACEHOLDER__
CLOUDINARY_API_SECRET=__PLACEHOLDER__

# -----------------------------------------------------------------------------
# Feature flags
# -----------------------------------------------------------------------------
# When true, Cash-on-Delivery is selectable at checkout.
COD_ENABLED=true

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=info
