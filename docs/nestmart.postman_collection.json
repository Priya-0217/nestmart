            "body": {
              "mode": "raw",
              "raw": "{ \"productId\": \"{{productId}}\", \"quantity\": 3 }"
            },
            "description": "Set quantity to 0 to remove. **200:** cart + totals."
          }
        },
        {
          "name": "DELETE /api/cart/items",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
