            "url": "{{baseUrl}}/api/orders",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentMethod\": \"cod\",\n  \"shippingAddress\": {\n    \"fullName\": \"Ankur T\",\n    \"phone\": \"+919999999999\",\n    \"line1\": \"221B Baker Street\",\n    \"city\": \"Pune\",\n    \"state\": \"MH\",\n    \"postalCode\": \"411001\",\n    \"country\": \"IN\"\n  }\n}"
            },
            "description": "Creates order from the current cart. Re-checks stock, recomputes totals, decrements stock, bumps coupon usage, clears cart, emails confirmation.\n\n**paymentMethod:** `stripe` | `razorpay` | `cod`. For `cod` the order is placed as `pending`; for stripe/razorpay the client flow then creates a payment intent via `/payments/*`."
          }
        },
