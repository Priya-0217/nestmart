          "name": "GET /api/cart",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/cart",
            "description": "Returns the user's cart with server-computed totals.\n\n**200:**\n```json\n{\n  \"cart\": { \"items\": [...], \"couponCode\": null },\n  \"totals\": { \"itemCount\": 2, \"subtotal\": 1598, \"discount\": 0, \"shipping\": 0, \"tax\": 287.64, \"total\": 1885.64, \"currency\": \"INR\", \"coupon\": null }\n}\n```"
          }
        },
        {
          "name": "POST /api/cart/items",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/cart/items",
            "body": {
              "mode": "raw",
              "raw": "{ \"productId\": \"{{productId}}\", \"quantity\": 1 }"
            },
            "description": "**201:** cart + totals. **400** on out-of-stock."
          }
        },
        {
          "name": "PATCH /api/cart/items",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
