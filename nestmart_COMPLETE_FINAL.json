{
	"info": {
		"_postman_id": "nestmart-ultimate-api",
		"name": "NestMart Ultimate API",
		"description": "Complete collection for ALL NestMart modules as per PRD requirements.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Register",
					"request": {
						"method": "POST",
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Nest User\",\n    \"email\": \"user@nestmart.com\",\n    \"password\": \"password123\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/register"
						}
					}
				},
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.accessToken) {",
									"    pm.environment.set(\"accessToken\", jsonData.accessToken);",
									"    pm.environment.set(\"refreshToken\", jsonData.refreshToken);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"admin@nestmart.com\",\n    \"password\": \"admin123\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login"
						}
					}
				},
				{
					"name": "Refresh Token",
					"request": {
						"method": "POST",
						"body": {
							"mode": "raw",
							"raw": "{\n    \"refreshToken\": \"{{refreshToken}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/refresh"
						}
					}
				},
				{
					"name": "Forgot Password",
					"request": {
						"method": "POST",
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"user@nestmart.com\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/forgot-password"
						}
					}
				}
			]
		},
		{
			"name": "Products & Categories",
			"item": [
				{
					"name": "List All Products",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/products?page=1&limit=20",
							"query": [
								{
									"key": "page",
									"value": "1"
								},
								{
									"key": "limit",
									"value": "20"
								}
							]
						}
					}
				},
				{
					"name": "Get Category Tree",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/categories/tree"
						}
					}
				}
			]
		},
		{
			"name": "Admin Panel",
			"item": [
				{
					"name": "Admin Stats",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/admin/stats"
						}
					}
				},
				{
					"name": "Create Product",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"body": {
							"mode": "raw",
							"raw": "{\n    \"title\": \"New Product\",\n    \"slug\": \"new-product-unique\",\n    \"price\": 499,\n    \"category\": \"CATEGORY_ID_HERE\",\n    \"stock\": 100,\n    \"images\": [\"https://images.unsplash.com/photo-1524758631624-e2822e304c36\"]\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/products"
						}
					}
				}
			]
		},
		{
			"name": "Product Detail Page (PDP)",
			"item": [
				{
					"name": "Get Product by ID",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/products/PRODUCT_ID_HERE"
						}
					}
				},
				{
					"name": "Get Related Products",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/products/PRODUCT_ID_HERE/related"
						}
					}
				},
				{
					"name": "Get Product Reviews",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/reviews?productId=PRODUCT_ID_HERE&status=approved"
						}
					}
				},
				{
					"name": "Submit Product Review",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"rating\": 5,\n  \"title\": \"Great product!\",\n  \"body\": \"I loved it.\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/reviews?productId=PRODUCT_ID_HERE"
						}
					}
				},
				{
					"name": "Add to Wishlist",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"productId\": \"PRODUCT_ID_HERE\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/users/me/wishlist"
						}
					}
				},
				{
					"name": "Remove from Wishlist",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "DELETE",
						"url": {
							"raw": "{{baseUrl}}/api/users/me/wishlist/PRODUCT_ID_HERE"
						}
					}
				},
				{
					"name": "Add to Cart",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"productId\": \"PRODUCT_ID_HERE\",\n  \"quantity\": 1\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/cart/items"
						}
					}
				}
			]
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:5000",
			"type": "string"
		},
		{
			"key": "accessToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "refreshToken",
			"value": "",
			"type": "string"
		}
	]
}