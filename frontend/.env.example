# =============================================================================
# NestMart Frontend — Environment Variables
# =============================================================================
# Copy to frontend/.env.local for local dev. Vars prefixed with NEXT_PUBLIC_
# are inlined into the browser bundle — never put secrets there.

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------
# Base URL the browser uses to hit the Express API (no trailing slash).
# Local:    http://localhost:5000
# Staging:  https://nestmart-api.onrender.com   (or whichever platform you pick)
NEXT_PUBLIC_API_URL=http://localhost:5000

# -----------------------------------------------------------------------------
# NextAuth — same-origin auth; the canonical URL your site is served from.
# -----------------------------------------------------------------------------
# Local:   http://localhost:3000
# Prod:    https://nestmart.com
NEXTAUTH_URL=http://localhost:3000

# Used by NextAuth to sign JWT session cookies.
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=dev-nextauth-secret-change-me-please

# -----------------------------------------------------------------------------
# Google OAuth (NextAuth provider)
#   console.cloud.google.com -> APIs & Services -> Credentials
#   Authorised redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=__PLACEHOLDER__google_client_id
GOOGLE_CLIENT_SECRET=__PLACEHOLDER__google_client_secret

# -----------------------------------------------------------------------------
# Stripe — publishable key only; secret key stays on the backend.
#   dashboard.stripe.com -> Developers -> API keys (test mode)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=__PLACEHOLDER__pk_test_xxx

# -----------------------------------------------------------------------------
# Razorpay — key id is public; secret stays on the backend.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=__PLACEHOLDER__rzp_test_xxx

# -----------------------------------------------------------------------------
# Sanity CMS — sanity.io/manage -> <your project> -> API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=__PLACEHOLDER__sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production
# Dated API version. Keep this pinned so Sanity schema changes don't surprise us.
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01
