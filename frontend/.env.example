# =============================================================================
# NestMart Frontend Environment Variables
# =============================================================================
# Copy this file to .env.local and fill each placeholder value.

# -----------------------------------------------------------------------------
# App + NextAuth
# -----------------------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
# Vercel: NEXTAUTH_URL and NEXT_PUBLIC_SITE_URL should be your Vercel domain
NEXTAUTH_SECRET=dev-nextauth-secret-change-me-please
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Database (Prisma + PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nestmart?schema=public

# -----------------------------------------------------------------------------
# Auth Providers
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=__PLACEHOLDER__google_client_id
GOOGLE_CLIENT_SECRET=__PLACEHOLDER__google_client_secret

# -----------------------------------------------------------------------------
# API base URL
# Local: http://localhost:5000   Render: https://nestmart-sy4h.onrender.com
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:5000

# -----------------------------------------------------------------------------
# Stripe
# -----------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=__PLACEHOLDER__pk_test_xxx
STRIPE_SECRET_KEY=__PLACEHOLDER__sk_test_xxx
STRIPE_WEBHOOK_SECRET=__PLACEHOLDER__whsec_xxx

# -----------------------------------------------------------------------------
# Sanity CMS
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=__PLACEHOLDER__sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# -----------------------------------------------------------------------------
# Transactional Email (Resend or SMTP)
# -----------------------------------------------------------------------------
EMAIL_FROM=NestMart <noreply@nestmart.local>
RESEND_API_KEY=__PLACEHOLDER__resend_api_key
SMTP_HOST=__PLACEHOLDER__smtp_host
SMTP_PORT=587
SMTP_USER=__PLACEHOLDER__smtp_user
SMTP_PASS=__PLACEHOLDER__smtp_pass

# -----------------------------------------------------------------------------
# Cloudinary image storage
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=__PLACEHOLDER__cloud_name
CLOUDINARY_API_KEY=__PLACEHOLDER__cloudinary_api_key
CLOUDINARY_API_SECRET=__PLACEHOLDER__cloudinary_api_secret
